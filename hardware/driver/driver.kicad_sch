	(text "LED current regulator: DAC0 → channel A (Q1, 0.05 R, up to 2.8 A) or channel B (Q5, 4.7 R, up to 117 mA)"
		(exclude_from_sim no)
		(at 25.40 157.00 0)
		(effects
			(font
				(size 2 2)
				bold)
			(justify left bottom))
		(uuid 68fe5942-5b7e-4425-9545-844cabb71552))
	(text "DAC VREF 1.1 V for A (47k/6.8k → 0-139 mV → 0-2.8 A, 10.8 mA/LSB), VREF 0.55 V for B (0-117 mA, 0.46 mA/LSB).\nUnused channel: its KILL pin driven high → FB ≈ VDD/2 → op-amp output low → FET off. Both KILL pins hi-Z = both channels live.\nOp-amp powered from PB4 → zero drain after LVP. Gates pulled down when MCU/op-amp are off."
		(exclude_from_sim no)
		(at 25.40 164.62 0)
		(effects
			(font
				(size 1.27 1.27))
			(justify left top))
		(uuid 2f186615-a7cf-4953-833a-43d3dd748d01))
